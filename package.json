{
  "name": "handan-campus",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "android:add": "cap add android",
    "ios:add": "cap add ios",
    "build:diagnostic": "vue-tsc --noEmit && vite build --mode android-diagnostic"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "ical.js": "^2.2.1",
    "lucide-vue-next": "^0.468.0",
    "papaparse": "^5.5.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.56.1",
    "@types/jsdom": "^21.1.7",
    "@types/papaparse": "^5.3.16",
    "@vitejs/plugin-vue": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }

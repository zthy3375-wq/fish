      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 20px;border:0;border-radius:var(--radius-sm);background:var(--color-tint);color:var(--color-primary);font:inherit;font-size:14px;font-weight:600;cursor:pointer;transition:background var(--motion-fast),color var(--motion-fast),transform var(--motion-fast) var(--ease-standard)}.ds-button-secondary:focus-visible{outline:2px solid var(--color-primary);outline-offset:3px}.ds-button-secondary:active{transform:scale(.98)}.ds-button-secondary:disabled{opacity:.35;cursor:default;transform:none}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"

      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">学习交流</button>",
      "css": ".ds-chip{min-height:36px;padding:0 12px;border:0;border-radius:18px;background:var(--color-bg);color:var(--color-muted);font:inherit;font-size:max(12px,.75rem);cursor:pointer;transition:color .14s,background .14s}.ds-chip[aria-pressed=true]{background:var(--color-tint);color:var(--color-primary)}.ds-chip:hover{background:var(--color-tint)}.ds-chip:focus-visible{outline:2px solid var(--color-primary);outline-offset:-2px}.ds-chip:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-chip{transition:none}}"
    },

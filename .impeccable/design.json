      "html": "<article class=\"ds-card\"><h2>任务名称</h2><p>正文与状态由真实业务内容提供。</p></article>",
      "css": ".ds-card{background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:16px;box-shadow:none}.ds-card h2{margin:0;font:inherit;font-size:16px;font-weight:650;line-height:1.5}.ds-card p{margin:8px 0 0;color:var(--color-muted);font-size:13px;line-height:1.8}"
    },
    {
      "name": "五入口底栏",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "展示五等分入口与选中指示；页面定位与安全区由宿主布局管理。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><button aria-current=\"page\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z\"/></svg><span>首页</span></button><button><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M16 3v4M8 3v4M3 11h18\"/></svg><span>课表</span></button><button><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z\"/></svg><span>社区</span></button><button><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"/><path d=\"m8 11 2 2 5-5M8 17h8\"/></svg><span>待办</span></button><button><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\"/></svg><span>我的</span></button></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));background:var(--color-surface);border-top:1px solid var(--color-divider);padding:4px 8px}.ds-nav button{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:4px;min-height:52px;min-width:0;background:transparent;border:0;border-radius:12px;color:var(--color-muted);font:inherit;cursor:pointer}.ds-nav span{font-size:11px;font-weight:500}.ds-nav button[aria-current=page]{background:var(--color-tint);color:var(--color-primary-strong)}.ds-nav button[aria-current=page] span{font-weight:650}.ds-nav button:hover{background:var(--color-highlight)}.ds-nav button:focus-visible{outline:2px solid var(--color-primary);outline-offset:3px}.ds-nav button:active{transform:scale(.98)}"

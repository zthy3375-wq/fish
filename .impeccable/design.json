      "description": "通用弹层中的原生文本输入。",
      "html": "<input class=\"ds-input\" aria-label=\"任务名称\" placeholder=\"输入任务名称\">",
      "css": ".ds-input{color:var(--color-text);background:var(--color-bg);border:1px solid var(--color-border);border-radius:var(--radius-sm);min-height:44px;padding:11px 12px;font:inherit;font-size:16px;caret-color:var(--color-primary)}.ds-input::placeholder{color:var(--color-muted);opacity:1}.ds-input:hover{border-color:var(--color-primary)}.ds-input:focus-visible{outline:2px solid var(--color-primary);outline-offset:3px}"
    },
